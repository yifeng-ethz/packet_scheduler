[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 16
bmc: multiclock on
bmc: wait on
cover: mode cover
cover: depth 16
cover: multiclock on
cover: wait on

[engines]
bmc: smtbmc bitwuzla
cover: smtbmc bitwuzla

[script]
read_verilog -formal -sv -DOPQ_OSS_FORMAL rtl/ordered_priority_queue_monolithic_ingress_parser.sv
read_verilog -formal -sv formal/opq_oss_ingress_formal_tb.sv
prep -top opq_oss_ingress_formal_tb

[files]
rtl/ordered_priority_queue_monolithic_ingress_parser.sv ../../rtl/sv_ver/ordered_priority_queue/monolithic_sv/ordered_priority_queue_monolithic_ingress_parser.sv
formal/opq_oss_ingress_formal_tb.sv ../uvm/formal/opq_oss_ingress_formal_tb.sv
