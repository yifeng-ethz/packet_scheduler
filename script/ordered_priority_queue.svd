<?xml version="1.0" encoding="UTF-8"?>
<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>Mu3e</vendor>
  <vendorID>MU3E</vendorID>
  <name>MU3E_ORDERED_PRIORITY_QUEUE</name>
  <series>MU3E_FPGA_IP</series>
  <version>26.5.1.0509</version>
  <description>CMSIS-SVD description of the ordered_priority_queue CSR aperture. BaseAddress is 0 because this file describes the relative CSR aperture of the IP; system integration supplies the live slave base address.</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>ORDERED_PRIORITY_QUEUE_CSR</name>
      <description>Relative CSR aperture for the ordered priority queue. Register offsets are byte offsets matching the RTL word-addressed Avalon-MM map multiplied by four.</description>
      <groupName>MU3E_DATA_PATH</groupName>
      <baseAddress>0x0</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x800</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>UID</name>
          <description>Software-visible IP identifier. Default ASCII &quot;OPQM&quot;.</description>
          <addressOffset>0x000</addressOffset>
          <access>read-only</access>
          <resetValue>0x4F50514D</resetValue>
          <fields>
            <field>
              <name>value</name>
              <description>Compile-time or integration-time UID word. Default ASCII &quot;OPQM&quot;.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>META</name>
          <description>Read-multiplexed metadata word. Write [1:0] selects VERSION, DATE, GIT, or INSTANCE_ID; reads return the selected page payload.</description>
          <addressOffset>0x004</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>page_sel_or_payload</name>
              <description>Writes use [1:0] as the metadata page selector; reads return the selected 32-bit payload.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LANE_MASK</name>
          <description>Software lane mask applied at packet boundaries. Low CAP.N_LANE bits are implemented.</description>
          <addressOffset>0x008</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>lane_mask</name>
              <description>Bit i masks lane i after the in-flight packet drains.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>reserved</name>
              <description>Reserved, read as zero.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRL</name>
          <description>Write-only control pulses.</description>
          <addressOffset>0x00C</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>clear_counters</name>
              <description>Write one to clear all software-visible counters and sticky handle FIFO overflow status.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>reserved</name>
              <description>Reserved; write zero for forward compatibility.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>31</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>STATUS</name>
          <description>Lane-mask shadow, busy flags, effective-mask status, lane count, and handle FIFO overflow summary.</description>
          <addressOffset>0x010</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>lane_mask_shadow</name>
              <description>Software-programmed lane mask shadow. Only low CAP.N_LANE bits are active.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>alloc_busy</name>
              <description>Page allocator is active.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>arbiter_busy</name>
              <description>Page-RAM write-port arbiter is active.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>presenter_busy</name>
              <description>Egress presenter has a valid beat pending or in flight.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
